<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;CS4014;VSTHRD110;VSTHRD100</WarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>HNMO</Authors>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/nguyentuanphu/HNMO/tree/master/src/Network</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nguyentuanphu/HNMO</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>HNMO Network TCP</PackageTags>
    <PackageId>HNMO.Network</PackageId>
    <Description>
      HNMO.Network contains all what's required to connect from and to an HNMO game, connect or chat server. It implements the game network protocol.
      It also contains several the encryption algorithms and keys which were used until a few years ago up to Season 6 Episode 3.
    </Description>
    <PackageVersion>0.10.0</PackageVersion>
    <Version>0.10.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\bin\Debug\</OutputPath>
    <DocumentationFile>..\..\bin\Debug\HNMO.Network.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\bin\Release\</OutputPath>
    <DocumentationFile>..\..\bin\Release\HNMO.Network.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Analyzer\**" />
    <EmbeddedResource Remove="Analyzer\**" />
    <None Remove="Analyzer\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Analyzer.WinForms\**" />
    <EmbeddedResource Remove="Analyzer.WinForms\**" />
    <None Remove="Analyzer.WinForms\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Packets\**" />
    <EmbeddedResource Remove="Packets\**" />
    <None Remove="Packets\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="LoginProbe\**" />
    <EmbeddedResource Remove="LoginProbe\**" />
    <None Remove="LoginProbe\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Nito.AsyncEx.Tasks" />
    <PackageReference Include="Pipelines.Sockets.Unofficial" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlugIns\HNMO.PlugIns.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\PlugInResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PlugInResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\PlugInResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>PlugInResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlugIns.Generators\HNMO.PlugIns.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
