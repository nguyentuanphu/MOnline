<?xml version="1.0" encoding="utf-8" ?>
<ConnectionSettings xmlns="https://github.com/nguyentuanphu/HNMO/ConnectionSettings">
  <Connections>
    <Connection>
      <!-- The user role of this context should have rights to create/update a database and user roles. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.EntityDataContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=postgres;Password=admin;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The admin panel user context. It uses the admin role, because the "admin" schema must be
           created before the game database exists. This schema is deliberately not granted to any
           of the game server roles, so a game server can't read or modify admin panel credentials. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.AdminAuth.AdminPanelContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=postgres;Password=admin;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The user role of this context should have rights to select/insert/update/delete data in all schemas. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.TypedContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=postgres;Password=admin;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The user role of this context should have rights to select the config schema -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.ConfigurationContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=config;Password=config;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The account context should connect with a user with less privileges. It should not be allowed to edit configuration tables, for example. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.AccountContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=account;Password=account;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The trade context should connect with a user with less privileges. It should just be allowed to edit the item table. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.TradeContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=account;Password=account;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The friend context should connect with a user with less privileges. It should not be allowed to edit configuration tables, for example. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.FriendContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=friend;Password=friend;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
    <Connection>
      <!-- The guild context should connect with a user with less privileges. It should not be allowed to edit Guild and GuildMember and to read the Character table. -->
      <ContextTypeName>HNMO.Persistence.EntityFramework.GuildContext</ContextTypeName>
      <ConnectionString>Server=localhost;Port=5432;User Id=guild;Password=guild;Database=hnmo;Command Timeout=120;</ConnectionString>
      <DatabaseEngine>Npgsql</DatabaseEngine>
    </Connection>
  </Connections>
</ConnectionSettings>
